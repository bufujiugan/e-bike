# Run python tools/configure.py to create .env with random local credentials.
BIKE_DB_URL=jdbc:mysql://127.0.0.1:3306/bike?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
BIKE_DB_USERNAME=bike
BIKE_DB_PASSWORD=CHANGE_ME
BIKE_MYSQL_ROOT_PASSWORD=CHANGE_ME
BIKE_JWT_SECRET=CHANGE_ME
BIKE_ADMIN_PASSWORD=CHANGE_ME
BIKE_SERVER_PORT=18080
BIKE_JWT_TTL=PT8H
# Use classpath:db/migration for a NEW disposable database with sample data.
BIKE_FLYWAY_LOCATIONS=classpath:db/migration-prod
BIKE_PRODUCTION_STORAGE=local
# Transport limits; production images and Excel still enforce their own 10MB limits.
BIKE_UPLOAD_MAX_FILE_SIZE=50MB
BIKE_UPLOAD_MAX_REQUEST_SIZE=160MB
BIKE_WEB_PORT=5173
BIKE_H5_PORT=5174
BIKE_BIND_ADDRESS=127.0.0.1
