<template>
  <scroll-view class="page" scroll-y
    ><view class="content"
      ><view class="card">
        <text class="title">修改密码</text
        ><text v-if="context && context.mustChangePassword" class="muted"
          >首次登录必须先修改密码。</text
        >
        <form-field
          v-model="currentPassword"
          label="当前密码"
          password
          :maxlength="100"
          :disabled="busy"
        />
        <form-field
          v-model="newPassword"
          label="新密码（8–100 位）"
          password
          :maxlength="100"
          :disabled="busy"
        />
        <form-field
          v-model="confirmation"
          label="确认新密码"
          password
          :maxlength="100"
          :disabled="busy"
        />
        <action-button
          label="保存并重新登录"
          :disabled="busy || !ready"
          @click="submit"
        />
        <text v-if="message" :class="['feedback', failed ? 'error' : '']">{{
          message
        }}</text>
      </view></view
    ></scroll-view
  >
</template>
<script>
import page from "../../common/page.js";
import { request } from "../../common/api.js";
import { clearSession } from "../../common/storage.js";
export default {
  mixins: [page],
  data: () => ({
    mode: "password",
    currentPassword: "",
    newPassword: "",
    confirmation: "",
  }),
  onHide() {
    this.currentPassword = "";
    this.newPassword = "";
    this.confirmation = "";
  },
  methods: {
    submit() {
      this.run(async () => {
        if (
          !this.currentPassword ||
          this.newPassword.length < 8 ||
          this.newPassword.length > 100 ||
          this.newPassword !== this.confirmation
        )
          throw new Error("请填写当前密码，新密码为 8–100 位且两次一致");
        await request("/api/auth/password", "PUT", {
          currentPassword: this.currentPassword,
          newPassword: this.newPassword,
        });
        clearSession();
        uni.reLaunch({ url: "/pages/login/login" });
      });
    },
  },
};
</script>
<style src="../../common/page.css"></style>
